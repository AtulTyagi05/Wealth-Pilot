# All values are server-side only. Never prefix them with NEXT_PUBLIC_.

# --- Database (Phase 5) -------------------------------------------------------
# Leave unset to run without accounts (data stays in the browser only).
DATABASE_URL=postgresql://wealthpilot:CHANGE_ME@localhost:5432/wealthpilot
# DATABASE_POOL_MAX=10
# DATABASE_SSL=disable          # only for databases on a private network in production

# Encryption keys for financial data: "version:base64-32-bytes", comma-separated.
# The highest version encrypts new writes; older versions are kept to decrypt existing rows.
# Generate one with: npm run gen:key
WP_DATA_KEYS=

# --- AI assistant (Phase 4) ----------------------------------------------------
ANTHROPIC_API_KEY=
# WP_ASSISTANT_MODEL=claude-opus-5-5
# WP_ASSISTANT_EFFORT=medium     # low | medium | high
